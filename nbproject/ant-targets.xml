<?xml version="1.0" encoding="UTF-8"?>
<project name="BibliotecaDigital-targets" default="jar" basedir="..">
    <property name="src.dir" location="src"/><property name="build.dir" location="build"/><property name="dist.dir" location="dist"/>
    <property name="classes.dir" location="${build.dir}/classes"/><property name="lib.dir" location="lib"/>
    <path id="classpath"><fileset dir="${lib.dir}"><include name="*.jar"/></fileset></path>
    <target name="clean"><delete dir="${build.dir}"/><delete dir="${dist.dir}"/></target>
    <target name="compile"><mkdir dir="${classes.dir}"/><copy todir="${classes.dir}"><fileset dir="${src.dir}" excludes="**/*.java"/></copy><javac srcdir="${src.dir}" destdir="${classes.dir}" source="21" target="21" encoding="UTF-8" includeantruntime="false"><classpath refid="classpath"/></javac></target>
    <target name="jar" depends="compile"><mkdir dir="${dist.dir}"/><jar destfile="${dist.dir}/BibliotecaDigital.jar"><fileset dir="${classes.dir}"/><manifest><attribute name="Main-Class" value="app.Main"/><attribute name="Class-Path" value="../lib/mysql-connector-j-9.4.0.jar"/></manifest></jar></target>
    <target name="default" depends="jar"/>
    <target name="run" depends="compile"><java classname="app.Main" fork="true"><classpath><pathelement location="${classes.dir}"/><path refid="classpath"/></classpath></java></target>
</project>
